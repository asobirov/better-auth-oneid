  "description": "Uzbekistan OneID provider helper for Better Auth",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepack": "npm run build"
  },
  "keywords": [
    "better-auth",
    "oneid",
    "uzbekistan",
    "oauth",
    "authentication"
  ],
  "author": "asobirov",
