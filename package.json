  "type": "module",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "better-auth": "^1.7.12",
    "typescript": "^6.0.3"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
